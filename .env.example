# Copy to .env.local and fill in. Vite only exposes variables prefixed VITE_.
# Core API (AttendanceMain)
VITE_BACKEND=http://localhost:3000/
# Report / admin service (AttendanceReport2)
VITE_REPORT_BACKEND=http://localhost:3000/
# Optional auth header for the core API. Never commit a real token.
VITE_AUTHORIZATION=
